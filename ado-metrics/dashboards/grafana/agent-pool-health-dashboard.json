{
  "__inputs": [
    {
      "name": "DS_AZURE_MONITOR",
      "label": "Azure Monitor",
      "description": "Azure Monitor Log Analytics data source",
      "type": "datasource",
      "pluginId": "grafana-azure-monitor-datasource",
      "pluginName": "Azure Monitor"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-azure-monitor-datasource",
      "name": "Azure Monitor",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Azure DevOps Agent Pool Health - queue depth, wait times, and running jobs",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "text": {},
        "textMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "azureLogAnalytics": {
            "query": "ADOOperationalMetrics_CL\n| where MetricName_s == \"AgentPoolOldestQueued\"\n| where TimeGenerated > ago(15m)\n| extend HealthState = case(\n    Value_d >= 15, \"Critical\",\n    Value_d >= 5,  \"Warning\",\n    \"Healthy\"\n  )\n| where HealthState == \"Critical\"\n| summarize count()",
            "resultFormat": "table"
          },
          "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        }
      ],
      "title": "🔴 Critical Pools",
      "type": "stat"
    },
    {
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "text": {},
        "textMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "azureLogAnalytics": {
            "query": "ADOOperationalMetrics_CL\n| where MetricName_s == \"AgentPoolOldestQueued\"\n| where TimeGenerated > ago(15m)\n| extend HealthState = case(\n    Value_d >= 15, \"Critical\",\n    Value_d >= 5,  \"Warning\",\n    \"Healthy\"\n  )\n| where HealthState == \"Warning\"\n| summarize count()",
            "resultFormat": "table"
          },
          "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        }
      ],
      "title": "🟡 Warning Pools",
      "type": "stat"
    },
    {
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "text": {},
        "textMode": "auto"
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "azureLogAnalytics": {
            "query": "ADOOperationalMetrics_CL\n| where MetricName_s == \"AgentPoolOldestQueued\"\n| where TimeGenerated > ago(15m)\n| extend HealthState = case(\n    Value_d >= 15, \"Critical\",\n    Value_d >= 5,  \"Warning\",\n    \"Healthy\"\n  )\n| where HealthState == \"Healthy\"\n| summarize count()",
            "resultFormat": "table"
          },
          "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        }
      ],
      "title": "🟢 Healthy Pools",
      "type": "stat"
    },
    {
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Minutes",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red",    "value": 15 }
            ]
          },
          "unit": "m"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "azureLogAnalytics": {
            "query": "ADOOperationalMetrics_CL\n| where MetricName_s == \"AgentPoolOldestQueued\"\n| where TimeGenerated > ago(4h)\n| summarize Value = max(Value_d) by PoolName_s, bin(TimeGenerated, 5m)\n| project TimeGenerated, PoolName_s, Value",
            "resultFormat": "time_series"
          },
          "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        }
      ],
      "title": "Queue Wait Time by Pool (minutes)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Jobs",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "azureLogAnalytics": {
            "query": "ADOOperationalMetrics_CL\n| where MetricName_s in (\"AgentPoolQueuedJobs\", \"AgentPoolRunningJobs\")\n| where TimeGenerated > ago(4h)\n| summarize Value = sum(Value_d) by MetricName_s, bin(TimeGenerated, 5m)\n| project TimeGenerated, MetricName_s, Value",
            "resultFormat": "time_series"
          },
          "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        }
      ],
      "title": "Queued vs Running Jobs (stacked)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "HealthState" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "Critical": { "color": "red",    "index": 0 } } },
                  { "type": "value", "options": { "Warning":  { "color": "yellow", "index": 1 } } },
                  { "type": "value", "options": { "Healthy":  { "color": "green",  "index": 2 } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "OldestQueued" },
            "properties": [
              { "id": "unit", "value": "m" },
              { "id": "decimals", "value": 1 }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "OldestQueued", "desc": true }]
      },
      "pluginVersion": "9.5.0",
      "targets": [
        {
          "azureLogAnalytics": {
            "query": "ADOOperationalMetrics_CL\n| where TimeGenerated > ago(15m)\n| summarize\n    Queued       = max(iif(MetricName_s == \"AgentPoolQueuedJobs\",  Value_d, 0.0)),\n    Running      = max(iif(MetricName_s == \"AgentPoolRunningJobs\", Value_d, 0.0)),\n    OldestQueued = max(iif(MetricName_s == \"AgentPoolOldestQueued\",Value_d, 0.0))\n  by PoolName_s\n| extend HealthState = case(\n    OldestQueued >= 15, \"Critical\",\n    OldestQueued >= 5,  \"Warning\",\n    \"Healthy\"\n  )\n| project\n    Pool         = PoolName_s,\n    Queued       = toint(Queued),\n    Running      = toint(Running),\n    OldestQueued,\n    HealthState\n| order by OldestQueued desc",
            "resultFormat": "table"
          },
          "datasource": { "type": "grafana-azure-monitor-datasource", "uid": "${DS_AZURE_MONITOR}" },
          "queryType": "Azure Log Analytics",
          "refId": "A"
        }
      ],
      "title": "Current Pool Status",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["azure-devops", "agent-pools", "operations"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-4h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"],
    "time_options": ["5m", "15m", "1h", "4h", "12h", "24h", "2d", "7d"]
  },
  "timezone": "browser",
  "title": "ADO Agent Pool Health",
  "uid": "ado-agent-pool-health",
  "version": 1,
  "weekStart": ""
}
